;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="KPC — Kot's photo collection"
config/version="0.03"
config/description="Сюжетная 3D-RPG про Кота: исследование, отель, гардероб и модные испытания."
